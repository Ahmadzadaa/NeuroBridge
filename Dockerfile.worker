# BizSim queue worker — ECS Fargate sidecar service
FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app

FROM base AS deps
COPY package.json package-lock.json ./
RUN npm ci

FROM base AS runner
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY src ./src
COPY scripts ./scripts
COPY tsconfig.json ./

# Production is PostgreSQL; the default schema is pinned to SQLite for local dev.
RUN node scripts/gen-postgres-schema.mjs && npx prisma generate --schema=prisma/schema.postgres.prisma

CMD ["npx", "tsx", "scripts/queue-worker.ts"]
