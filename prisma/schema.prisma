generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String  @id @default(cuid())
  name      String
  logoUrl   String? @map("logo_url")
  website   String?
  phone     String?
  email     String?
  address   String?
  status    String  @default("PENDING")
  seatLimit Int     @default(0) @map("seat_limit")
  seatsUsed Int     @default(0) @map("seats_used")
  planType  String? @map("plan_type")

  /// UNIVERSITY | TECHNOPARK | FULL — a preset that seeds the flags below.
  /// It is only a starting point; each flag can be changed independently
  /// afterwards, so e.g. a university can still run a hackathon.
  tenantType String @default("FULL") @map("tenant_type")

  /// Module entitlements, set by the platform owner. Default to true so
  /// organisations created before this existed keep everything they had.
  teachersEnabled    Boolean  @default(true) @map("teachers_enabled")
  hackathonEnabled   Boolean  @default(true) @map("hackathon_enabled")
  simulationsEnabled Boolean  @default(true) @map("simulations_enabled")
  trainingsEnabled   Boolean  @default(true) @map("trainings_enabled")
  aiToolsEnabled     Boolean  @default(true) @map("ai_tools_enabled")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  users     User[]
  programs  Program[]
  payments  Payment[]
  auditLogs AuditLog[]
  settings  TenantSettings?

  subscription   Subscription?
  invoices       Invoice[]
  paymentMethods PaymentMethod[]
  seatChangeLogs SeatChangeLog[]

  services TenantService[]
  orders   Order[]

  universities   University[]
  departments    Department[]
  notifications  TenantNotification[]
  supportTickets SupportTicket[]

  certificates         Certificate[]
  certificateSequences CertificateSequence[]
  aiMessages           AiMessage[]

  @@map("tenants")
}

model TenantSettings {
  id                         String  @id @default(cuid())
  tenantId                   String  @unique @map("tenant_id")
  authorizedContact          String? @map("authorized_contact")
  signatureUrl               String? @map("signature_url")
  certificateTemplate        String? @map("certificate_template")
  participationCertificate   Boolean @default(true) @map("participation_certificate")
  achievementCertificate     Boolean @default(true) @map("achievement_certificate")
  completionCertificate      Boolean @default(true) @map("completion_certificate")
  sendInvitationEmail        Boolean @default(true) @map("send_invitation_email")
  programStartReminder       Boolean @default(true) @map("program_start_reminder")
  programEndReminder         Boolean @default(true) @map("program_end_reminder")
  certificateNotification    Boolean @default(true) @map("certificate_notification")
  weeklyProgressNotification Boolean @default(true) @map("weekly_progress_notification")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model User {
  id           String  @id @default(cuid())
  tenantId     String? @map("tenant_id")
  email        String
  passwordHash String  @map("password_hash")
  firstName    String? @map("first_name")
  lastName     String? @map("last_name")
  phone        String?
  role         String  @default("PARTICIPANT")
  language     String  @default("tr")
  coinBalance  Int     @default(0) @map("coin_balance")

  // Academic profile, collected at registration for university participants.
  // Nullable because accounts created before this existed have none.
  university   String?
  faculty      String?
  specialty    String?
  /// Year of study, 1–6.
  studyYear    Int?    @map("study_year")
  /// Picked from the reference lists; the free-text fields above stay as the
  /// fallback for anything not in them.
  universityId String? @map("university_id")
  departmentId String? @map("department_id")

  /// Stored avatar file, relative to uploads/avatars. Served through an
  /// authenticated route — never exposed as a public static path.
  avatarPath String? @map("avatar_path")

  /// Juror profile shown to the organisation and on the jury screen:
  /// current role ("Founder, X Ventures") and a few lines of experience.
  headline String?
  bio      String?

  teacherId           String?   @map("teacher_id")
  inviteToken         String?   @unique @map("invite_token")
  twoFactorEnabled    Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret     String?   @map("two_factor_secret")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant              Tenant?                   @relation(fields: [tenantId], references: [id])
  participants        Participant[]
  userBadges          UserBadge[]
  certificates        Certificate[]
  coinTransactions    CoinTransaction[]
  auditLogs           AuditLog[]
  recoveryCodes       UserRecoveryCode[]
  examAttempts        ExamAttempt[]
  lessonProgress      LessonProgress[]
  lessonVideoWatches  LessonVideoWatch[]
  lessonVideoAnswers  LessonVideoAnswer[]
  teamMemberships     TeamMember[]
  juryScores          JuryScore[]
  simulationRuns      SimulationRun[]
  teacher             User?                     @relation("TeacherStudents", fields: [teacherId], references: [id])
  students            User[]                    @relation("TeacherStudents")
  authoredSimulations Simulation[]              @relation("AuthoredSimulations")
  approvedInvoices    Invoice[]                 @relation("InvoiceApprover")
  seatChanges         SeatChangeLog[]           @relation("SeatChangeActor")
  activationTokens    ActivationToken[]
  consents            UserConsent[]
  assessmentResults   AssessmentResult[]
  projectSubmissions  LessonProjectSubmission[]
  juryAssignments     ProgramJuror[]
  finalistEntries     ProgramFinalist[]
  finalistScores      FinalistScore[]
  finalistReviews     FinalistReview[]
  aiMessages          AiMessage[]
  supportTickets      SupportTicket[]           @relation("SupportTicketCreator")
  supportMessages     SupportMessage[]
  notifications       Notification[]
  universityRef       University?               @relation(fields: [universityId], references: [id])
  departmentRef       Department?               @relation(fields: [departmentId], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([teacherId])
  @@index([email])
  @@map("users")
}

model UserRecoveryCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_recovery_codes")
}

model Program {
  id                   String    @id @default(cuid())
  tenantId             String    @map("tenant_id")
  name                 String
  description          String?
  type                 String
  applicationStart     DateTime  @map("application_start")
  applicationEnd       DateTime  @map("application_end")
  simulationStart      DateTime? @map("simulation_start")
  simulationEnd        DateTime? @map("simulation_end")
  /// Calendar dates (UTC midnight) bounding the 6-week plan.
  programStart         DateTime? @map("program_start")
  programEnd           DateTime? @map("program_end")
  finalistCount        Int?      @map("finalist_count")
  juryEnabled          Boolean   @default(false) @map("jury_enabled")
  /// Set when the organisation confirms the finalist list; jurors see finalists only after this.
  finalistsConfirmedAt DateTime? @map("finalists_confirmed_at")
  /// Name printed on the completion certificate, shown on the program info screen.
  certificateName      String?   @map("certificate_name")
  participantLimit     Int       @map("participant_limit")
  applicationToken     String    @unique @default(cuid()) @map("application_token")
  resultsRevealAt      DateTime? @map("results_reveal_at")
  /// PENDING_SETUP: created from a paid order, waiting for the platform team
  /// to fill in name, dates and content; applications stay closed. READY: live.
  setupStatus          String    @default("READY") @map("setup_status")
  /// The purchase that paid for this programme (null for ones made by hand).
  orderId              String?   @map("order_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order              Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  participants       Participant[]
  programSimulations ProgramSimulation[]
  programTrainings   ProgramTraining[]
  programAiTools     ProgramAiTool[]
  hackathonTeams     HackathonTeam[]
  scheduleItems      ProgramScheduleItem[]
  jurors             ProgramJuror[]
  finalists          ProgramFinalist[]
  assessmentResults  AssessmentResult[]

  certificates Certificate[]

  @@index([tenantId])
  @@index([setupStatus])
  @@index([orderId])
  @@map("programs")
}

model ProgramSimulation {
  id             String @id @default(cuid())
  programId      String @map("program_id")
  simulationType String @map("simulation_type")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, simulationType])
  @@map("program_simulations")
}

model ProgramTraining {
  id           String @id @default(cuid())
  programId    String @map("program_id")
  trainingType String @map("training_type")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, trainingType])
  @@map("program_trainings")
}

model ProgramAiTool {
  id        String @id @default(cuid())
  programId String @map("program_id")
  aiTool    String @map("ai_tool")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, aiTool])
  @@map("program_ai_tools")
}

model Participant {
  id               String    @id @default(cuid())
  programId        String    @map("program_id")
  userId           String    @map("user_id")
  status           String    @default("PENDING")
  registrationDate DateTime  @default(now()) @map("registration_date")
  lastLogin        DateTime? @map("last_login")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([programId, userId])
  @@index([programId])
  @@index([userId])
  /// Enrolment counts filter on programme + ACTIVE status, and on the
  /// registration date for the selected window.
  @@index([programId, status])
  @@index([registrationDate])
  @@map("participants")
}

model Simulation {
  id          String            @id @default(cuid())
  key         String            @unique
  nameTr      String            @map("name_tr")
  nameEn      String            @map("name_en")
  nameAz      String            @map("name_az")
  category    String
  description String?
  startCash   Int               @default(1000) @map("start_cash")
  targetCash  Int               @default(3000) @map("target_cash")
  // Platform scenarios have tenantId = null; teacher-authored scenarios
  // belong to a tenant and their creator.
  tenantId    String?           @map("tenant_id")
  createdById String?           @map("created_by_id")
  createdBy   User?             @relation("AuthoredSimulations", fields: [createdById], references: [id])
  tasks       SimulationTask[]
  rounds      SimulationRound[]
  runs        SimulationRun[]

  @@index([tenantId])
  @@index([createdById])
  @@map("simulations")
}

model SimulationRound {
  id           String @id @default(cuid())
  simulationId String @map("simulation_id")
  order        Int
  title        String
  context      String

  simulation Simulation           @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  choices    SimulationChoice[]
  decisions  SimulationDecision[]

  @@unique([simulationId, order])
  @@map("simulation_rounds")
}

model SimulationChoice {
  id                String  @id @default(cuid())
  roundId           String  @map("round_id")
  label             String
  detail            String?
  cashDelta         Int     @default(0) @map("cash_delta")
  satisfactionDelta Int     @default(0) @map("satisfaction_delta")
  reputationDelta   Int     @default(0) @map("reputation_delta")
  variance          Int     @default(0)
  feedback          String
  order             Int     @default(0)

  round     SimulationRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  decisions SimulationDecision[]

  @@index([roundId])
  @@map("simulation_choices")
}

model SimulationRun {
  id              String    @id @default(cuid())
  simulationId    String    @map("simulation_id")
  userId          String    @map("user_id")
  status          String    @default("IN_PROGRESS")
  currentRound    Int       @default(1) @map("current_round")
  cash            Int
  satisfaction    Int
  reputation      Int
  score           Int?
  teacherGrade    Int?      @map("teacher_grade")
  teacherMaxGrade Int?      @map("teacher_max_grade")
  teacherComment  String?   @map("teacher_comment")
  gradedByUserId  String?   @map("graded_by_user_id")
  gradedAt        DateTime? @map("graded_at")
  startedAt       DateTime  @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")

  simulation Simulation           @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisions  SimulationDecision[]

  @@index([userId])
  @@index([simulationId])
  @@map("simulation_runs")
}

model SimulationDecision {
  id                String   @id @default(cuid())
  runId             String   @map("run_id")
  roundId           String   @map("round_id")
  choiceId          String   @map("choice_id")
  cashAfter         Int      @map("cash_after")
  satisfactionAfter Int      @map("satisfaction_after")
  reputationAfter   Int      @map("reputation_after")
  createdAt         DateTime @default(now()) @map("created_at")

  run    SimulationRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  round  SimulationRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  choice SimulationChoice @relation(fields: [choiceId], references: [id], onDelete: Cascade)

  @@unique([runId, roundId])
  @@map("simulation_decisions")
}

model SimulationTask {
  id             String   @id @default(cuid())
  simulationId   String   @map("simulation_id")
  title          String
  titleTr        String   @map("title_tr")
  titleEn        String   @map("title_en")
  titleAz        String   @map("title_az")
  scenarioText   String   @map("scenario_text")
  submissionType String   @map("submission_type")
  linkedBadgeKey String   @map("linked_badge_key")
  coinReward     Int      @map("coin_reward")
  order          Int
  createdAt      DateTime @default(now()) @map("created_at")

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([simulationId])
  @@map("simulation_tasks")
}

model Training {
  id            String   @id @default(cuid())
  key           String   @unique
  titleTr       String   @map("title_tr")
  titleEn       String   @map("title_en")
  titleAz       String   @map("title_az")
  description   String?
  descriptionTr String?  @map("description_tr")
  descriptionEn String?  @map("description_en")
  descriptionAz String?  @map("description_az")
  category      String?
  lessons       Lesson[]
  exams         Exam[]

  @@map("trainings")
}

model Lesson {
  id               String   @id @default(cuid())
  trainingId       String   @map("training_id")
  title            String
  titleTr          String   @map("title_tr")
  titleEn          String   @map("title_en")
  titleAz          String   @map("title_az")
  content          String
  videoUrl         String?  @map("video_url")
  /// Storage key of an uploaded video (served by /api/lessons/[id]/video/file);
  /// takes precedence over videoUrl.
  videoKey         String?  @map("video_key")
  /// Set by the platform team; the watch rules trust it over what a browser reports.
  videoDurationSec Int?     @map("video_duration_sec")
  estimatedMinutes Int      @map("estimated_minutes")
  order            Int
  createdAt        DateTime @default(now()) @map("created_at")

  // Training-unit fields (video -> project -> test -> points). Null/0 on
  // ordinary lessons.
  /// Program-calendar activity this unit belongs to, e.g. CREATIVE_THINKING.
  activity     String?
  /// JSON {"scenario": string, "tasks": string[]} — the unit's project brief.
  projectBrief String? @map("project_brief")
  /// Coins awarded the first time the unit test is passed.
  points       Int     @default(0)

  training           Training                  @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  progress           LessonProgress[]
  unitExams          Exam[]
  projectSubmissions LessonProjectSubmission[]
  videoQuestions     LessonVideoQuestion[]
  videoWatches       LessonVideoWatch[]

  @@index([trainingId])
  @@map("lessons")
}

/// A question that pauses the lesson video at `atSecond` until it is answered.
model LessonVideoQuestion {
  id           String   @id @default(cuid())
  lessonId     String   @map("lesson_id")
  atSecond     Int      @map("at_second")
  /// Trilingual JSON (see src/lib/i18n-content.ts).
  prompt       String
  /// JSON array of trilingual option texts.
  options      String
  correctIndex Int      @map("correct_index")
  createdAt    DateTime @default(now()) @map("created_at")

  lesson  Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answers LessonVideoAnswer[]

  @@index([lessonId, atSecond])
  @@map("lesson_video_questions")
}

/// How far a participant has really watched a lesson video. The server only
/// lets `maxWatchedSec` grow as fast as the video can play (see video-watch.ts).
model LessonVideoWatch {
  id            String    @id @default(cuid())
  lessonId      String    @map("lesson_id")
  userId        String    @map("user_id")
  /// Duration the browser reported, used when the lesson has none set.
  durationSec   Int       @default(0) @map("duration_sec")
  maxWatchedSec Int       @default(0) @map("max_watched_sec")
  lastBeatAt    DateTime  @default(now()) @map("last_beat_at")
  startedAt     DateTime  @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
  @@index([userId])
  @@map("lesson_video_watches")
}

/// Every attempt at an in-video question; the first one feeds the attention score.
model LessonVideoAnswer {
  id         String   @id @default(cuid())
  questionId String   @map("question_id")
  userId     String   @map("user_id")
  choice     Int
  correct    Boolean
  createdAt  DateTime @default(now()) @map("created_at")

  question LessonVideoQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId, userId])
  @@index([userId])
  @@map("lesson_video_answers")
}

model Exam {
  id               String        @id @default(cuid())
  trainingId       String        @map("training_id")
  title            String
  titleTr          String        @map("title_tr")
  titleEn          String        @map("title_en")
  titleAz          String        @map("title_az")
  passingThreshold Int           @map("passing_threshold")
  /// Set when this is a training unit's test; the unit's points are the reward.
  lessonId         String?       @map("lesson_id")
  questions        Question[]
  attempts         ExamAttempt[]

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  lesson   Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([trainingId])
  @@index([lessonId])
  @@map("exams")
}

model Question {
  id            String @id @default(cuid())
  examId        String @map("exam_id")
  questionText  String @map("question_text")
  optionA       String @map("option_a")
  optionB       String @map("option_b")
  optionC       String @map("option_c")
  optionD       String @map("option_d")
  correctOption String @map("correct_option")
  explanation   String
  order         Int

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@map("questions")
}

model ExamAttempt {
  id          String   @id @default(cuid())
  examId      String   @map("exam_id")
  userId      String   @map("user_id")
  score       Int
  passed      Boolean
  completedAt DateTime @default(now()) @map("completed_at")

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([examId, userId])
  @@index([userId])
  /// Average-score rollups filter by exam set; see lib/analytics.
  @@index([examId, completedAt])
  @@map("exam_attempts")
}

model LessonProgress {
  id          String   @id @default(cuid())
  lessonId    String   @map("lesson_id")
  userId      String   @map("user_id")
  completedAt DateTime @default(now()) @map("completed_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
  @@index([userId])
  /// Analytics reads progress by lesson set and by week; without these the
  /// tenant dashboard degrades into a full scan of the table.
  @@index([completedAt])
  @@index([lessonId, completedAt])
  @@map("lesson_progress")
}

model HackathonTeam {
  id        String   @id @default(cuid())
  programId String   @map("program_id")
  name      String
  slogan    String?
  createdAt DateTime @default(now()) @map("created_at")

  program     Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  submissions ProjectSubmission[]

  @@unique([programId, name])
  @@index([programId])
  @@map("hackathon_teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String   @map("team_id")
  userId   String   @map("user_id")
  isLeader Boolean  @default(false) @map("is_leader")
  joinedAt DateTime @default(now()) @map("joined_at")

  team HackathonTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model ProjectSubmission {
  id          String   @id @default(cuid())
  teamId      String   @map("team_id")
  title       String
  summary     String?
  fileName    String   @map("file_name")
  filePath    String   @map("file_path")
  fileSize    Int      @map("file_size")
  version     Int      @default(1)
  submittedBy String   @map("submitted_by")
  createdAt   DateTime @default(now()) @map("created_at")

  team   HackathonTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  scores JuryScore[]

  @@index([teamId])
  @@map("project_submissions")
}

model JuryCriterion {
  id        String  @id @default(cuid())
  programId String  @map("program_id")
  name      String
  nameTr    String? @map("name_tr")
  nameEn    String? @map("name_en")
  nameAz    String? @map("name_az")
  maxScore  Int     @default(10) @map("max_score")
  weight    Int     @default(1)
  order     Int     @default(0)

  scores         JuryScore[]
  finalistScores FinalistScore[]

  @@index([programId])
  @@map("jury_criteria")
}

/// A juror invited to evaluate one programme's finalists.
model ProgramJuror {
  id        String   @id @default(cuid())
  programId String   @map("program_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([programId, userId])
  @@index([userId])
  @@map("program_jurors")
}

/// A student chosen for the jury round, with the platform evaluation that put them there.
model ProgramFinalist {
  id            String   @id @default(cuid())
  programId     String   @map("program_id")
  userId        String   @map("user_id")
  /// Unit points at selection time, and the student's place in the programme by them.
  platformScore Int      @map("platform_score")
  platformRank  Int      @map("platform_rank")
  createdAt     DateTime @default(now()) @map("created_at")

  program Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores  FinalistScore[]
  reviews FinalistReview[]

  @@unique([programId, userId])
  @@index([userId])
  @@map("program_finalists")
}

/// One juror's score for one finalist on one criterion.
model FinalistScore {
  id          String   @id @default(cuid())
  finalistId  String   @map("finalist_id")
  criterionId String   @map("criterion_id")
  juryUserId  String   @map("jury_user_id")
  score       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  finalist  ProgramFinalist @relation(fields: [finalistId], references: [id], onDelete: Cascade)
  criterion JuryCriterion   @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  jury      User            @relation(fields: [juryUserId], references: [id], onDelete: Cascade)

  @@unique([finalistId, criterionId, juryUserId])
  @@index([juryUserId])
  @@map("finalist_scores")
}

/// A juror's overall note on a finalist; `submittedAt` marks their evaluation as final.
model FinalistReview {
  id          String    @id @default(cuid())
  finalistId  String    @map("finalist_id")
  juryUserId  String    @map("jury_user_id")
  comment     String?
  submittedAt DateTime? @map("submitted_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  finalist ProgramFinalist @relation(fields: [finalistId], references: [id], onDelete: Cascade)
  jury     User            @relation(fields: [juryUserId], references: [id], onDelete: Cascade)

  @@unique([finalistId, juryUserId])
  @@index([juryUserId])
  @@map("finalist_reviews")
}

model JuryScore {
  id           String   @id @default(cuid())
  submissionId String   @map("submission_id")
  criterionId  String   @map("criterion_id")
  juryUserId   String   @map("jury_user_id")
  score        Int
  comment      String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  submission ProjectSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  criterion  JuryCriterion     @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  jury       User              @relation(fields: [juryUserId], references: [id], onDelete: Cascade)

  @@unique([submissionId, criterionId, juryUserId])
  @@index([juryUserId])
  @@map("jury_scores")
}

model Badge {
  id        String @id @default(cuid())
  key       String @unique
  nameTr    String @map("name_tr")
  nameEn    String @map("name_en")
  nameAz    String @map("name_az")
  icon      String
  coinValue Int    @map("coin_value")
  category  String
  tier      String @default("regular")

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  badgeId  String   @map("badge_id")
  earnedAt DateTime @default(now()) @map("earned_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model Certificate {
  id        String  @id @default(cuid())
  tenantId  String  @map("tenant_id")
  userId    String  @map("user_id")
  programId String? @map("program_id")

  /// PARTICIPATION | ACHIEVEMENT | COMPLETION
  type       String
  /// Which visual template rendered the PDF (see src/lib/certificates/templates.ts).
  templateId String? @map("template_id")

  /// Human-readable and sequential per tenant per year: BIZ-2026-DEM-000417.
  serialNumber String @unique @map("serial_number")
  /// Random public lookup key. Verification must never accept the serial —
  /// a sequential id would let anyone enumerate every certificate issued.
  verifyCode   String @unique @map("verify_code")

  /// Snapshots taken at issue time. A certificate is an issued document: it
  /// must not change when the holder renames themselves or an admin edits the
  /// programme title afterwards.
  recipientName String  @map("recipient_name")
  title         String
  locale        String  @default("az")
  /// The wording and the organisation name printed on the document, kept so
  /// the on-screen likeness shows exactly what the PDF says. Null on rows
  /// issued before these were kept: the template's default wording applies.
  body          String?
  issuerName    String? @map("issuer_name")

  issuedAt      DateTime  @default(now()) @map("issued_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")

  /// Path under uploads/certificates, plus a hash so a re-download can be
  /// proven identical to what was issued.
  pdfPath String? @map("pdf_path")
  pdfHash String? @map("pdf_hash")

  issuedByUserId String? @map("issued_by_user_id")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  /// Scoped per programme, not globally per type. The previous userId+type
  /// rule made a second PARTICIPATION certificate impossible for anyone who
  /// joined a second programme.
  @@unique([userId, type, programId])
  @@index([userId])
  @@index([tenantId, issuedAt])
  @@index([verifyCode])
  @@map("certificates")
}

/// Per-tenant, per-year counter behind the serial number. Incremented in the
/// same transaction that creates the certificate so two concurrent bulk issues
/// cannot mint the same serial.
model CertificateSequence {
  id        String @id @default(cuid())
  tenantId  String @map("tenant_id")
  year      Int
  lastValue Int    @default(0) @map("last_value")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, year])
  @@map("certificate_sequences")
}

model CoinTransaction {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  amount    Int
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("coin_transactions")
}

model Payment {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  amount         Float
  currency       String   @default("TRY")
  seatCount      Int      @map("seat_count")
  status         String   @default("PENDING")
  provider       String   @default("STRIPE")
  providerRef    String?  @map("provider_ref")
  paymentType    String   @default("UPGRADE") @map("payment_type")
  idempotencyKey String   @unique @map("idempotency_key")
  refundedAmount Float    @default(0) @map("refunded_amount")
  retryCount     Int      @default(0) @map("retry_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRef])
  @@index([tenantId])
  @@index([status])
  @@map("payments")
}

model WebhookEvent {
  id              String   @id @default(cuid())
  provider        String
  externalEventId String   @map("external_event_id")
  eventType       String   @map("event_type")
  status          String   @default("PROCESSED")
  payload         String?
  errorMessage    String?  @map("error_message")
  signatureValid  Boolean? @map("signature_valid")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([provider, externalEventId])
  @@index([provider])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Billing (PayTR seat-based subscriptions)
//
// All money is stored as INTEGER kuruş (1 TRY = 100 kuruş). Never Float.
// Statuses are String (not enum) because the SQLite connector used in local
// dev does not support Prisma enums; the union types live in src/lib/types.ts.
// ---------------------------------------------------------------------------

model Plan {
  id                  String   @id @default(cuid())
  name                String
  pricePerSeatMonthly Int      @map("price_per_seat_monthly")
  currency            String   @default("TRY")
  minSeats            Int      @default(1) @map("min_seats")
  trialDays           Int      @default(0) @map("trial_days")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@index([isActive])
  @@map("plans")
}

model Subscription {
  id       String @id @default(cuid())
  tenantId String @unique @map("tenant_id")
  planId   String @map("plan_id")

  /// TRIALING | ACTIVE | PAST_DUE | CANCELED | EXPIRED
  status String @default("TRIALING")

  seats        Int
  /// Seat reduction is deferred to the end of the current period.
  pendingSeats Int? @map("pending_seats")

  /// Contract price negotiated per tenant, snapshotted from Plan at signup.
  pricePerSeatMonthly Int    @map("price_per_seat_monthly")
  currency            String @default("TRY")

  currentPeriodStart DateTime  @map("current_period_start")
  currentPeriodEnd   DateTime  @map("current_period_end")
  trialEndsAt        DateTime? @map("trial_ends_at")
  canceledAt         DateTime? @map("canceled_at")

  /// Dunning bookkeeping (retry on day 1, 3, 5; expire after 7).
  pastDueSince    DateTime? @map("past_due_since")
  dunningAttempts Int       @default(0) @map("dunning_attempts")
  nextRetryAt     DateTime? @map("next_retry_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([status])
  @@index([currentPeriodEnd])
  @@index([nextRetryAt])
  @@map("subscriptions")
}

model PaymentMethod {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  provider String @default("PAYTR")

  /// PayTR card vault handles. PAN/CVV/expiry never touch this system.
  utoken    String
  ctoken    String?
  cardMask  String? @map("card_mask")
  cardBrand String? @map("card_brand")

  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([provider, utoken, ctoken])
  @@index([tenantId])
  @@map("payment_methods")
}

model Invoice {
  id             String  @id @default(cuid())
  tenantId       String  @map("tenant_id")
  subscriptionId String? @map("subscription_id")

  /// PayTR order id: alphanumeric only, never reused. BIZ{tenant}{ts}{rand}
  merchantOid String @unique @map("merchant_oid")

  /// Integer kuruş.
  amount   Int
  currency String @default("TRY")

  /// SUBSCRIPTION | SEAT_UPGRADE
  type   String
  /// PENDING | PAID | FAILED | REFUNDED
  status String @default("PENDING")
  /// PAYTR | MANUAL — MANUAL is the offline "bank transfer" flow.
  method String @default("PAYTR")

  seatCount   Int?      @map("seat_count")
  periodStart DateTime? @map("period_start")
  periodEnd   DateTime? @map("period_end")
  paidAt      DateTime? @map("paid_at")

  /// Set only for method = MANUAL, when a super admin confirms the transfer.
  approvedBy String?   @map("approved_by")
  approvedAt DateTime? @map("approved_at")
  note       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription?        @relation(fields: [subscriptionId], references: [id])
  approver     User?                @relation("InvoiceApprover", fields: [approvedBy], references: [id])
  transactions PaymentTransaction[]
  seatChanges  SeatChangeLog[]

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("invoices")
}

model PaymentTransaction {
  id          String @id @default(cuid())
  invoiceId   String @map("invoice_id")
  provider    String @default("PAYTR")
  merchantOid String @map("merchant_oid")

  amount Int
  /// PENDING | SUCCESS | FAILED
  status String

  /// Raw provider response as a JSON string (SQLite has no native Json).
  rawResponse      String? @map("raw_response")
  failedReasonCode String? @map("failed_reason_code")
  failedReasonMsg  String? @map("failed_reason_msg")
  attemptNo        Int     @default(1) @map("attempt_no")

  createdAt DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([merchantOid])
  @@map("payment_transactions")
}

/// Append-only log of every PayTR notification, written before the payload is
/// trusted and regardless of whether it is acted on.
///
/// `webhook_events` already enforces idempotency (one row per merchant_oid),
/// which means it cannot answer "how many times did PayTR call us, and what
/// did the second call say?" — exactly the question a disputed payment raises.
/// This table is the other half: one row per HTTP request, duplicates and
/// rejected hashes included.
///
/// `raw_payload` is stored with secrets masked (see paytr-log.ts): the hash and
/// any card handle are replaced, because a stored signature can be replayed.
model PaytrWebhookEvent {
  id          String @id @default(cuid())
  merchantOid String @map("merchant_oid")

  /// As reported by PayTR: success | failed. Null when the body did not parse.
  status      String?
  hashValid   Boolean @map("hash_valid")
  /// sandbox | live — which credential set verified (or failed to verify) this.
  mode        String
  totalAmount String? @map("total_amount")
  paymentType String? @map("payment_type")

  failedReasonCode String? @map("failed_reason_code")
  failedReasonMsg  String? @map("failed_reason_msg")

  /// PROCESSED | DUPLICATE | REJECTED | UNMATCHED | ERROR
  outcome      String
  errorMessage String? @map("error_message")

  /// Recorded, never enforced on: PayTR's source IPs are not contractually
  /// fixed, so this is evidence for building an allowlist, not a gate.
  remoteIp   String? @map("remote_ip")
  rawPayload String  @map("raw_payload")

  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  @@index([merchantOid])
  @@index([receivedAt])
  @@index([outcome])
  @@map("paytr_webhook_events")
}

model SeatChangeLog {
  id        String  @id @default(cuid())
  tenantId  String  @map("tenant_id")
  oldSeats  Int     @map("old_seats")
  newSeats  Int     @map("new_seats")
  changedBy String? @map("changed_by")
  invoiceId String? @map("invoice_id")
  /// UPGRADE | DOWNGRADE_SCHEDULED | DOWNGRADE_APPLIED | ADMIN_OVERRIDE
  reason    String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  actor   User?    @relation("SeatChangeActor", fields: [changedBy], references: [id])

  @@index([tenantId])
  @@index([createdAt])
  @@map("seat_change_logs")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  tenantId  String?  @map("tenant_id")
  ip        String?
  action    String
  details   String?
  createdAt DateTime @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([action])
  @@index([userId])
  @@index([createdAt])
  /// Active-user counts scan one tenant's LOGIN_SUCCESS rows over a window;
  /// the single-column indexes above force a merge that this avoids.
  @@index([tenantId, action, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Service-based pricing and self-serve onboarding
//
// Each service is priced per participant, with the unit price chosen by
// participant-count tier. Money is INTEGER kuruş, statuses are String — same
// rules as the billing models above.
// ---------------------------------------------------------------------------

model Service {
  id        String   @id @default(cuid())
  /// Stable key, e.g. HACKATHON | TEACHERS | SIMULATIONS | TRAININGS | AI_TOOLS.
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tiers          ServicePriceTier[]
  orderItems     OrderItem[]
  tenantServices TenantService[]

  @@index([active])
  @@map("services")
}

model ServicePriceTier {
  id                  String @id @default(cuid())
  serviceId           String @map("service_id")
  minParticipants     Int    @map("min_participants")
  /// Null means no upper bound.
  maxParticipants     Int?   @map("max_participants")
  pricePerParticipant Int    @map("price_per_participant")
  currency            String @default("TRY")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, minParticipants])
  @@map("service_price_tiers")
}

model Order {
  id               String    @id @default(cuid())
  institutionName  String    @map("institution_name")
  contactName      String    @map("contact_name")
  contactEmail     String    @map("contact_email")
  /// Locale the buyer used, so the activation email goes out in it.
  locale           String    @default("tr")
  /// PENDING | PAID | FAILED
  status           String    @default("PENDING")
  total            Int
  currency         String    @default("TRY")
  paytrMerchantOid String    @unique @map("paytr_merchant_oid")
  /// NEW_TENANT: first purchase, provisions the organisation. ADD_PROGRAM: an
  /// existing organisation buying another programme (tenantId set up front).
  kind             String    @default("NEW_TENANT")
  tenantId         String?   @map("tenant_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  paidAt           DateTime? @map("paid_at")

  tenant   Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  programs Program[]

  @@index([status])
  @@index([tenantId])
  @@map("orders")
}

model OrderItem {
  id               String @id @default(cuid())
  orderId          String @map("order_id")
  serviceId        String @map("service_id")
  participantCount Int    @map("participant_count")
  /// Snapshot at order time; later tier changes never alter a placed order.
  unitPrice        Int    @map("unit_price")
  subtotal         Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

/// A service a tenant has bought, with its participant limit.
model TenantService {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  serviceId        String   @map("service_id")
  participantLimit Int      @map("participant_limit")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@unique([tenantId, serviceId])
  @@map("tenant_services")
}

/// One-time set-password link. Only the SHA-256 hash of the token is stored.
model ActivationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("activation_tokens")
}

// ---------------------------------------------------------------------------
// Student flow: reference lists, consents, program calendar
// ---------------------------------------------------------------------------

/// Universities for the registration select. Rows with a null tenantId are the
/// platform-wide list (imported from docs/spec); a tenant can add its own,
/// e.g. Azerbaijani universities, without touching the shared list.
model University {
  id        String   @id @default(cuid())
  name      String
  city      String?
  /// ISO 3166-1 alpha-2.
  country   String   @default("TR")
  tenantId  String?  @map("tenant_id")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@index([tenantId])
  @@index([country, name])
  @@map("universities")
}

/// Departments for the registration select, grouped by field of study.
/// Same platform-wide / per-tenant split as University.
model Department {
  id        String   @id @default(cuid())
  name      String
  /// Field of study ("Alan"), e.g. Eğitim, Mühendislik.
  field     String?
  tenantId  String?  @map("tenant_id")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@index([tenantId])
  @@index([field, name])
  @@map("departments")
}

/// Append-only consent log. The latest row per (user, type) is the current
/// answer; older rows are kept as the audit trail KVKK/GDPR requires.
model UserConsent {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  /// PRIVACY_NOTICE (required) | DATA_USE | OPPORTUNITIES | PSYCH_RESULTS_SHARE
  type      String
  granted   Boolean
  /// What the user saw, e.g. "kvkk-tr@2026-09" or "2026-09".
  version   String
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@map("user_consents")
}

/// One row of a program's 6-week plan. Generated from the program dates, then
/// editable by the university (e.g. moving a jury presentation).
model ProgramScheduleItem {
  id        String    @id @default(cuid())
  programId String    @map("program_id")
  week      Int
  /// See PROGRAM_ACTIVITIES in src/lib/programs/schedule.ts.
  activity  String
  startsOn  DateTime  @map("starts_on")
  endsOn    DateTime  @map("ends_on")
  sortOrder Int       @map("sort_order")
  /// Set when the university changed the generated dates.
  editedAt  DateTime? @map("edited_at")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, sortOrder])
  @@map("program_schedule_items")
}

// ---------------------------------------------------------------------------
// Baseline assessments. Questions, dimensions and feedback texts are data, so
// the real instruments can be imported later without code changes. Localized
// text columns hold JSON: {"tr": "...", "en": "...", "az": "..."} (SQLite has
// no JSON column type).
// ---------------------------------------------------------------------------

model Assessment {
  id          String  @id @default(cuid())
  /// Stable key, e.g. CHARACTER_CREATIVITY | PSYCH_STATE.
  code        String  @unique
  /// CHARACTER | PSYCH. PSYCH results reach the university only with the
  /// student's PSYCH_RESULTS_SHARE consent.
  kind        String
  version     String
  /// Placeholder content for testing the flow; never shown as a real result.
  isDemo      Boolean @default(false) @map("is_demo")
  active      Boolean @default(true)
  title       String
  description String?
  /// Likert scale bounds.
  scaleMin    Int     @default(1) @map("scale_min")
  scaleMax    Int     @default(5) @map("scale_max")
  sortOrder   Int     @default(0) @map("sort_order")

  dimensions AssessmentDimension[]
  questions  AssessmentQuestion[]
  results    AssessmentResult[]

  @@map("assessments")
}

model AssessmentDimension {
  id           String @id @default(cuid())
  assessmentId String @map("assessment_id")
  code         String
  label        String
  /// Feedback for a low (<40), medium (40-69) and high (>=70) score.
  lowText      String @map("low_text")
  midText      String @map("mid_text")
  highText     String @map("high_text")
  sortOrder    Int    @default(0) @map("sort_order")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, code])
  @@map("assessment_dimensions")
}

model AssessmentQuestion {
  id            String  @id @default(cuid())
  assessmentId  String  @map("assessment_id")
  dimensionCode String  @map("dimension_code")
  text          String
  /// Agreement lowers the score (e.g. "I often feel overwhelmed").
  reverse       Boolean @default(false)
  sortOrder     Int     @default(0) @map("sort_order")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId, sortOrder])
  @@map("assessment_questions")
}

model AssessmentResult {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  programId         String   @map("program_id")
  assessmentId      String   @map("assessment_id")
  assessmentVersion String   @map("assessment_version")
  /// JSON {questionId: answer}.
  answers           String
  /// JSON {dimensionCode: 0-100}.
  scores            String
  completedAt       DateTime @default(now()) @map("completed_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  program    Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([userId, programId, assessmentId])
  @@index([programId])
  @@map("assessment_results")
}

/// In-panel notices for the university (e.g. a student finished the baseline
/// analysis).
model TenantNotification {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  /// e.g. ASSESSMENTS_COMPLETED
  type      String
  /// JSON with the ids the panel needs to link to.
  payload   String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, readAt, createdAt])
  @@map("tenant_notifications")
}

/// A student's answer to a training unit's project step.
model LessonProjectSubmission {
  id          String   @id @default(cuid())
  lessonId    String   @map("lesson_id")
  userId      String   @map("user_id")
  content     String
  submittedAt DateTime @default(now()) @map("submitted_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
  @@index([userId])
  @@map("lesson_project_submissions")
}

/// A demo request from the public marketing site.
///
/// Deliberately outside the tenant graph: a lead is someone who does not have
/// an organisation on the platform yet, so there is no tenantId to scope it by
/// and no user to attach it to. Sales staff read these; the marketing pages
/// only ever write.
model Lead {
  id        String  @id @default(cuid())
  name      String
  company   String
  email     String
  phone     String?
  /// Roughly how many seats they expect to need. Free text, because the
  /// answer on a marketing form is a guess, not a commitment.
  seatCount String?
  message   String?

  /// Which language the form was submitted in, so a reply goes out in it.
  locale String  @default("az")
  /// Marketing attribution, when the visitor arrived with parameters.
  source String?

  /// NEW | CONTACTED | QUALIFIED | CLOSED — moved by sales, not by the site.
  status String @default("NEW")

  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([email])
  @@map("leads")
}

/// One turn of a participant's AI Mentor conversation, scoped to a tenant, a
/// user and a simulation. Kept only as the mentor's memory: never logged, and
/// only ever sent back with the same participant's own next request.
model AiMessage {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  userId       String   @map("user_id")
  simulationId String   @map("simulation_id")
  /// user | assistant
  role         String
  content      String
  /// Private storage key of an attached image, never a public URL.
  imageKey     String?  @map("image_key")
  /// ok | off_topic | blocked | error — how this turn was handled.
  status       String   @default("ok")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, simulationId, createdAt])
  @@index([tenantId, createdAt])
  @@map("ai_messages")
}

/// Rolling summary of the turns older than the verbatim window.
model AiConversationSummary {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  userId       String   @map("user_id")
  simulationId String   @map("simulation_id")
  summary      String
  /// createdAt of the newest message folded into the summary.
  coveredUntil DateTime @map("covered_until")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, userId, simulationId])
  @@map("ai_conversation_summaries")
}

/// One LLM call: who (hashed), which model, how many tokens, what it cost.
/// No message content and no names.
model AiUsageLog {
  id               String   @id @default(cuid())
  tenantId         String?  @map("tenant_id")
  userHash         String   @map("user_hash")
  simulationId     String?  @map("simulation_id")
  /// topic_check | mentor | summary
  purpose          String
  model            String
  inputTokens      Int      @default(0) @map("input_tokens")
  outputTokens     Int      @default(0) @map("output_tokens")
  cacheReadTokens  Int      @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int      @default(0) @map("cache_write_tokens")
  costUsd          Float    @default(0) @map("cost_usd")
  /// Pre-filter verdict of the request: on_topic | off_topic | invalid.
  prefilter        String?
  rejectReason     String?  @map("reject_reason")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

/// Security-relevant AI events, kept apart from usage: off-topic and
/// injection rejections, canary triggers, limits, redactions, budget alerts.
model AiSecurityEvent {
  id           String   @id @default(cuid())
  tenantId     String?  @map("tenant_id")
  userHash     String?  @map("user_hash")
  simulationId String?  @map("simulation_id")
  type         String
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([type, createdAt])
  @@index([userHash, type, createdAt])
  @@map("ai_security_events")
}

/// A tenant admin's question to the platform team, with its conversation.
model SupportTicket {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  createdById   String    @map("created_by_id")
  subject       String
  /// OPEN (the platform team owes a reply) | ANSWERED (the organisation does) | RESOLVED
  status        String    @default("OPEN")
  lastMessageAt DateTime  @default(now()) @map("last_message_at")
  /// When each side last opened the thread; a newer message from the other side is unread.
  tenantReadAt  DateTime? @map("tenant_read_at")
  staffReadAt   DateTime? @map("staff_read_at")
  /// JSON: the browser, screen and time zone the request was sent from, for troubleshooting.
  context       String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User             @relation("SupportTicketCreator", fields: [createdById], references: [id], onDelete: Cascade)
  messages  SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([tenantId, lastMessageAt])
  @@map("support_tickets")
}

model SupportMessage {
  id           String    @id @default(cuid())
  ticketId     String    @map("ticket_id")
  authorId     String    @map("author_id")
  /// Written by the platform team rather than the organisation.
  fromStaff    Boolean   @default(false) @map("from_staff")
  body         String
  /// JSON {locale: text}: translations made on request, kept so each is paid for once.
  translations String?
  createdAt    DateTime  @default(now()) @map("created_at")
  /// Set when the author changed the text; shown as "edited" so the other side knows.
  editedAt     DateTime? @map("edited_at")
  /// Set when the author removed the message: text and files are gone, a placeholder keeps the thread readable.
  deletedAt    DateTime? @map("deleted_at")

  attachments SupportAttachment[]
  ticket      SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User                @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

/// Something one person should know about, shown under the bell. The text is
/// rendered from `type` and `params` in the reader's language, so nothing
/// user-facing is stored in a single language.
model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  /// e.g. SUPPORT_REPLY, CERTIFICATE_ISSUED — one i18n entry per type
  type      String
  /// JSON values for the message, e.g. {"subject": "..."}
  params    String    @default("{}")
  /// In-app path without the locale, e.g. /tenant/support/abc
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// A picture or file sent with a support message. The bytes live in storage
/// under `key`; they are served only to the two sides of the conversation.
model SupportAttachment {
  id          String   @id @default(cuid())
  messageId   String   @map("message_id")
  key         String
  name        String
  contentType String   @map("content_type")
  size        Int
  createdAt   DateTime @default(now()) @map("created_at")

  message SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("support_attachments")
}
