{
  "name": "bizsimesas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:setup": "prisma generate && prisma db push --accept-data-loss && prisma db seed",
    "db:reset-demo": "tsx scripts/reset-demo-passwords.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-demo": "tsx prisma/seed-demo.ts",
    "db:seed-hackathon": "tsx prisma/seed-hackathon.ts",
    "db:seed-demo:reset": "tsx prisma/seed-demo.ts --reset",
    "db:push": "prisma db push",
    "db:rls": "psql %DATABASE_URL% -f prisma/migrations/rls/001_enable_rls.sql",
    "db:backup": "bash scripts/backup-db.sh",
    "test": "vitest run",
    "test:integration": "vitest run src/**/*.integration.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:perf": "vitest run src/lib/__tests__/pagination.test.ts src/lib/cache/__tests__/cache-service.test.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "test:coverage": "vitest run --coverage",
    "worker": "tsx scripts/queue-worker.ts",
    "worker:once": "tsx scripts/queue-worker.ts --once",
    "load:health": "k6 run scripts/load/health.js",
    "docker:build": "docker build -t bizsim-web:local .",
    "docker:build:worker": "docker build -f Dockerfile.worker -t bizsim-worker:local .",
    "terraform:validate": "cd infra/terraform && terraform init -backend=false && terraform validate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1068.0",
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^10.57.0",
    "@tanstack/react-query": "^5.101.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.79.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "stripe": "^22.2.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "dotenv": "^16.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
