# Database — local dev uses SQLite (no Docker required)
DATABASE_URL="file:./dev.db"
# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET="your-auth-secret-here-min-32-chars"

# Two-factor encryption (generate with: openssl rand -base64 32)
TOTP_ENCRYPTION_KEY="your-totp-encryption-key-32-chars"
# Two-factor login for admins. Off unless set to "true".
TWO_FACTOR_ENABLED="false"

# Rate limiting (required in production)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# AI Mentor (see README "AI Mentor"). Leave values empty here; set them in the
# secret store. Every limit has a default, so only the provider is required.
AI_MENTOR_ENABLED=""
# anthropic | bedrock
AI_PROVIDER=""
# Provider "anthropic": the key is read by the SDK. Provider "bedrock": no key;
# the EC2 instance role is used, region from AI_BEDROCK_REGION or AWS_REGION.
ANTHROPIC_API_KEY=""
AI_BEDROCK_REGION=""
# Model overrides (defaults: Haiku 4.5 for classifier and mentor, Sonnet 5.5 for analysis)
AI_MODEL_CLASSIFIER=""
AI_MODEL_MENTOR=""
AI_MODEL_ANALYSIS=""
# Limits (defaults in brackets)
AI_DAILY_MESSAGES=""                # [25] per participant per day
AI_DAILY_IMAGES=""                  # [3] per participant per day
AI_MAX_MESSAGE_CHARS=""             # [500]
AI_MAX_OUTPUT_TOKENS=""             # [600]
AI_RESTRICTED_MAX_OUTPUT_TOKENS=""  # [250] once the global daily ceiling is reached
AI_MIN_INTERVAL_SECONDS=""          # [4] between one participant's messages
AI_MAX_IMAGE_BYTES=""               # [2000000]
AI_IMAGE_STAGES=""                  # [unit] stage kinds that accept images: unit,round
AI_TENANT_MONTHLY_TOKENS=""         # [2000000] per organisation per month
AI_GLOBAL_DAILY_USD=""              # [20] platform-wide daily ceiling
AI_ANOMALY_THRESHOLD=""             # [8] rejections in the window before a temporary block
AI_ANOMALY_WINDOW_MINUTES=""        # [10]
AI_BLOCK_MINUTES=""                 # [15]
AI_PRICES_JSON=""                   # optional per-model USD/MTok override for cost estimates
AI_ALERT_EMAIL=""                   # operations address for the global spend alert
AI_LOG_HASH_SECRET=""               # key for hashing user ids in AI logs (falls back to AUTH_SECRET)
AI_PROMPT_CANARY=""                 # optional fixed canary word; random per process if empty
NEXT_PUBLIC_AI_VOICE_ENABLED=""     # microphone/avatar slots; keep false until the voice phase

# Payments (PayTR)
# Names only — never commit real values. In production these come from the
# secret store, not from a file on disk.
#
# Which account is used. Defaults to sandbox when unset: a missing variable
# must cost a failed test payment, never a real charge.
#   sandbox → PAYTR_SANDBOX_* (falls back to the legacy PAYTR_MERCHANT_*)
#   live    → PAYTR_LIVE_* only, and the app refuses to boot without all three
PAYTR_MODE="sandbox"

PAYTR_SANDBOX_MERCHANT_ID=""
PAYTR_SANDBOX_MERCHANT_KEY=""
PAYTR_SANDBOX_MERCHANT_SALT=""

# Set these only on the production secret store. Never in a file on disk.
PAYTR_LIVE_MERCHANT_ID=""
PAYTR_LIVE_MERCHANT_KEY=""
PAYTR_LIVE_MERCHANT_SALT=""

# Pre-split names. Still read in sandbox mode, ignored in live mode.
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""

# Sandbox mode always sends test_mode=1. In live mode, "1" is the go-live
# rehearsal: real credentials, real callback URL, no money moved. Unset it to
# start taking real payments. See docs/paytr-golive-checklist.md.
PAYTR_TEST_MODE=""

# 1 only if the PayTR merchant account has Non3D enabled, which automatic
# recurring charges require. Leave at 0 until PayTR confirms it.
PAYTR_NON3D_ENABLED="0"

# Integration tests (PostgreSQL)
TEST_DATABASE_URL="postgresql://bizsim:bizsim@localhost:5432/bizsim_test?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Monitoring — Sentry
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_ENVIRONMENT="development"

# Monitoring — AWS CloudWatch (optional)
AWS_REGION=""
CLOUDWATCH_NAMESPACE="BizSim/Production"

# AWS deployment (ECS / S3)
S3_ASSETS_BUCKET=""
S3_BACKUPS_BUCKET=""

# Document storage (issued certificates)
# "local" writes under uploads/ — fine for development, NEVER for ECS, where
# the container filesystem is ephemeral and every issued certificate would be
# lost on the next deploy. Defaults to "s3" when NODE_ENV=production.
STORAGE_DRIVER="local"
# Fully private bucket, separate from S3_ASSETS_BUCKET (which is fronted by
# CloudFront for public assets). Required when STORAGE_DRIVER=s3.
S3_DOCUMENTS_BUCKET=""
# Lifetime in seconds of a signed download link. Kept short: the download
# route checks revocation before minting one, and a signed URL cannot be
# withdrawn once issued.
STORAGE_SIGNED_URL_TTL="300"

# Marketing site — where demo requests from /contact are announced.
# Falls back to EMAIL_FROM when unset, so a lead is never dropped silently.
LEADS_NOTIFICATION_EMAIL=""

# Email notifications
# "ses" in production (requires AWS credentials + verified sender),
# "console" in dev — emails are logged and written to uploads/dev-emails/
EMAIL_PROVIDER="console"
EMAIL_FROM="BizSim <no-reply@example.com>"
# Absolute origin used in email links (falls back to the request origin)
APP_BASE_URL=""
