# Database — local dev uses SQLite (no Docker required)
DATABASE_URL="file:./dev.db"
# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET="your-auth-secret-here-min-32-chars"

# Two-factor encryption (generate with: openssl rand -base64 32)
TOTP_ENCRYPTION_KEY="your-totp-encryption-key-32-chars"

# Rate limiting (required in production)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# AI
ANTHROPIC_API_KEY=""

# Payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYRIFF_API_KEY=""
PAYRIFF_MERCHANT_ID=""
PAYRIFF_WEBHOOK_SECRET=""
PAYRIFF_API_BASE="https://api.payriff.com/api/v2"
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_WEBHOOK_SECRET=""
IYZICO_API_BASE="https://api.iyzipay.com"

# Integration tests (PostgreSQL)
TEST_DATABASE_URL="postgresql://bizsim:bizsim@localhost:5432/bizsim_test?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Monitoring — Sentry
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_ENVIRONMENT="development"

# Monitoring — AWS CloudWatch (optional)
AWS_REGION=""
CLOUDWATCH_NAMESPACE="BizSim/Production"

# AWS deployment (ECS / S3)
S3_ASSETS_BUCKET=""
S3_BACKUPS_BUCKET=""
